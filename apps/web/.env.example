# Supabase (lihat docs/backend.md). Publishable key aman dipakai di browser.
# Secret key Supabase TIDAK PERNAH dipakai di frontend dan tidak boleh di-commit.
NUXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Mock API surat (opsional, untuk development sebelum backend siap). Aktifkan keduanya.
# NUXT_MOCK_API=1
# NUXT_PUBLIC_API_BASE=/mock-api

# Kanal "Lapor masalah" untuk tester beta (opsional). `{pesan}` diganti isi laporan yang sudah
# di-encode. Kosong berarti GitHub Issues repo ini, yang bisa dibaca publik. Contoh:
# NUXT_PUBLIC_FEEDBACK_URL=https://wa.me/62xxxxxxxxxx?text={pesan}
# NUXT_PUBLIC_FEEDBACK_URL=https://docs.google.com/forms/d/e/<id>/viewform?usp=pp_url&entry.<n>={pesan}
