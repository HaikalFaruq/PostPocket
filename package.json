{
  "name": "postpocket",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "pnpm --filter @postpocket/web dev",
    "build": "pnpm --filter @postpocket/web build",
    "preview": "pnpm --filter @postpocket/web preview",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @postpocket/web test:e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.1": "^0.28.2"
    }
  }
}
